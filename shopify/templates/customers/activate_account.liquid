<div class="page">
  <div class="phead"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <span aria-current="page">Activate account</span></nav><h1 class="h-display">Activate your <span class="it">account</span></h1></div></div>
  <section style="padding-top:30px"><div class="wrap narrow">
    <div class="card">{%- form 'activate_customer_password' -%}
      {%- if form.errors %}<p class="form-note">{{ form.errors | default_errors }}</p>{% endif -%}
      <div class="fgrid2"><div class="field full"><input id="ap1" type="password" name="customer[password]" placeholder=" " autocomplete="new-password" required><label for="ap1">Password</label></div><div class="field full"><input id="ap2" type="password" name="customer[password_confirmation]" placeholder=" " autocomplete="new-password" required><label for="ap2">Confirm password</label></div></div>
      <button class="btn block" type="submit" style="margin-top:16px">Activate account</button>
    {%- endform -%}</div>
  </div></section>
</div>
