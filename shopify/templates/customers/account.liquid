<div class="page">
  <div class="phead"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <span aria-current="page">Account</span></nav><h1 class="h-display">Your <span class="it">account</span></h1></div></div>
  <section style="padding-top:30px"><div class="wrap narrow">
    <p class="lead">Hello {{ customer.first_name | default: customer.email }} · <a href="{{ routes.account_logout_url }}" style="text-decoration:underline">Log out</a></p>
    <div class="card" style="margin-top:20px">
      <h2 class="h-sec" style="font-size:24px">Order history</h2>
      {%- paginate customer.orders by 20 -%}
      {%- if customer.orders.size > 0 -%}
        <table style="width:100%;border-collapse:collapse;margin-top:12px"><thead><tr><th style="text-align:left">Order</th><th style="text-align:left">Date</th><th style="text-align:left">Status</th><th style="text-align:right">Total</th></tr></thead><tbody>
        {%- for order in customer.orders -%}
          <tr><td><a href="{{ order.customer_url }}" style="text-decoration:underline">{{ order.name }}</a></td><td>{{ order.created_at | date: '%b %d, %Y' }}</td><td>{{ order.fulfillment_status_label }}</td><td style="text-align:right">{{ order.total_price | money }}</td></tr>
        {%- endfor -%}
        </tbody></table>
      {%- else -%}<p>You haven't placed any orders yet. <a href="{{ routes.all_products_collection_url }}" style="text-decoration:underline">Shop the collection</a></p>{%- endif -%}
      {%- endpaginate -%}
    </div>
    <div class="card" style="margin-top:20px"><h2 class="h-sec" style="font-size:24px">Default address</h2>{{ customer.default_address | format_address }}<p><a href="{{ routes.account_addresses_url }}" style="text-decoration:underline">Manage addresses ({{ customer.addresses_count }})</a></p></div>
  </div></section>
</div>
