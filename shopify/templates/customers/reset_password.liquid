<div class="page">
  <div class="phead"><div class="wrap"><nav class="crumbs" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <span aria-current="page">Reset password</span></nav><h1 class="h-display">Reset <span class="it">password</span></h1></div></div>
  <section style="padding-top:30px"><div class="wrap narrow">
    <div class="card">{%- form 'reset_customer_password' -%}
      {%- if form.errors %}<p class="form-note">{{ form.errors | default_errors }}</p>{% endif -%}
      <div class="fgrid2"><div class="field full"><input id="np" type="password" name="customer[password]" placeholder=" " autocomplete="new-password" required><label for="np">New password</label></div><div class="field full"><input id="npc" type="password" name="customer[password_confirmation]" placeholder=" " autocomplete="new-password" required><label for="npc">Confirm password</label></div></div>
      <button class="btn block" type="submit" style="margin-top:16px">Reset password</button>
    {%- endform -%}</div>
  </div></section>
</div>
