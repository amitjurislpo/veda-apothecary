<div class="announce" id="announce" aria-live="polite" data-messages="[&quot;Free US shipping on orders over &lt;b&gt;$50&lt;/b&gt;&quot;,&quot;Use code &lt;b&gt;VEDA10&lt;/b&gt; for 10% off your first order&quot;,&quot;Subscribe &amp;amp; save &lt;b&gt;10%&lt;/b&gt; on every delivery&quot;,&quot;GMP · ISO certified · &lt;b&gt;100% pure&lt;/b&gt;, nothing added&quot;]"><div><span>Free US shipping on orders over <b>$50</b></span></div></div>
<header class="site" id="hdr">
  <div class="wrap nav">
    <nav class="nav-left" aria-label="Primary">
      <a href="/collections/all" data-nav="shop"{% if template.name == 'collection' or template.name == 'list-collections' or template.name == 'product' %} class="active" aria-current="page"{% endif %}>Shop</a>
      <a href="/blogs/journal" data-nav="blog"{% if template.name == 'blog' or template.name == 'article' %} class="active" aria-current="page"{% endif %}>Blog</a>
      <a href="/pages/about" data-nav="about"{% if template.name == 'page' and page.handle == 'about' %} class="active" aria-current="page"{% endif %}>Our Story</a>
      <a href="/pages/wholesale" data-nav="wholesale"{% if template.name == 'page' and page.handle == 'wholesale' %} class="active" aria-current="page"{% endif %}>Wholesale</a>
    </nav>
    <button class="icon-btn menu-btn" type="button" aria-label="Open menu" aria-controls="mnav" data-menu="open"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h18M3 12h18M3 17h12"/></svg></button>
    <a href="/" class="logo" aria-label="Veda Apothecary home"><img class="lg-dark" src="{{ 'logo.png' | asset_url }}" alt="Veda Apothecary" width="360" height="258" loading="eager" fetchpriority="high"><img class="lg-light" src="{{ 'logo-light.png' | asset_url }}" alt="Veda Apothecary" width="360" height="258" loading="lazy" decoding="async"></a>
    <div class="nav-right">
      <button class="icon-btn" type="button" aria-label="Search" data-search="open"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg></button>
      <a class="icon-btn hide-m" href="{{ routes.account_url }}" aria-label="Account"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg></a>
      <button class="icon-btn" type="button" aria-label="Open cart, {{ cart.item_count }} items" data-cart="open"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 8h14l-1.2 11.2a2 2 0 0 1-2 1.8H8.2a2 2 0 0 1-2-1.8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg><span class="cart-count{% if cart.item_count > 0 %} on{% endif %}" id="cc" aria-hidden="true">{{ cart.item_count }}</span></button>
    </div>
  </div>
</header>
<div class="mobile-nav" id="mnav" role="dialog" aria-label="Menu">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px">
    <img src="{{ 'logo.png' | asset_url }}" alt="Veda Apothecary" width="360" height="258" loading="lazy" decoding="async" style="height:50px;width:auto">
    <button class="icon-btn" type="button" aria-label="Close menu" data-menu="close"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
  </div>
  <a href="/">Home</a>
  <a href="/collections/all">Shop All</a>
  <a href="/blogs/journal">Blog</a>
  <a href="/pages/about">Our Story</a>
  <a href="/pages/wholesale">Wholesale</a>
  <a href="/pages/faq">FAQ</a>
  <a href="/pages/contact">Contact</a>
</div>
<div class="search" id="search" role="dialog" aria-label="Search">
  <div class="wrap">
    <div style="display:flex;gap:16px;align-items:center">
      <label for="sq" class="eyebrow" style="white-space:nowrap">Search</label>
      <input id="sq" type="search" placeholder="Moringa, calm, digestion…" autocomplete="off">
      <button class="icon-btn" type="button" aria-label="Close search" data-search="close"><svg class="icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg></button>
    </div>
    <div class="sres" id="sres"></div>
  </div>
</div>

{% schema %}
{
  "name": "Header",
  "settings": []
}
{% endschema %}
