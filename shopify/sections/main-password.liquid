<div class="page" style="min-height:70vh;display:grid;place-items:center;text-align:center;padding:60px 20px">
  <div style="max-width:520px">
    <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" width="360" height="258" style="width:200px;height:auto;display:block;margin:0 auto">
    <h1 class="h-display" style="font-size:40px;margin-top:20px">Opening <span class="it">soon</span></h1>
    {%- if shop.password_message != blank %}<p class="lead">{{ shop.password_message }}</p>{% else %}<p class="lead">Pure single-ingredient Ayurvedic powders, shipped across the USA from Texas.</p>{% endif %}
    {%- form 'storefront_password' -%}
      {%- if form.errors %}<p class="form-note">{{ form.errors | default_errors }}</p>{% endif -%}
      <div class="field" style="margin-top:24px"><input id="pw" type="password" name="password" placeholder=" " autocomplete="current-password"><label for="pw">Store password</label></div>
      <button class="btn block" type="submit" style="margin-top:12px">Enter</button>
    {%- endform -%}
    <p style="margin-top:22px;font-size:13px;color:var(--muted)">Store owner? <a href="/admin" style="text-decoration:underline">Log in here</a></p>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": []
}
{% endschema %}
