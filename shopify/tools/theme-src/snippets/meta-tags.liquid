{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_type = 'website'
  assign og_image = 'og-default.jpg' | asset_url
  if template.name == 'product'
    assign og_type = 'product'
    case product.handle
      when 'moringa-powder'
        assign og_image = 'og-moringa.jpg' | asset_url
      when 'ashwagandha-powder'
        assign og_image = 'og-ashwagandha.jpg' | asset_url
      when 'triphala-powder'
        assign og_image = 'og-triphala.jpg' | asset_url
      when 'amla-powder'
        assign og_image = 'og-amla.jpg' | asset_url
      else
        if product.featured_image
          assign og_image = product.featured_image | image_url: width: 1200
        endif
    endcase
  elsif template.name == 'article'
    assign og_type = 'article'
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:locale" content="en_US">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
{%- if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:image" content="https:{{ og_image | remove: 'https:' }}">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
{%- if page_description %}<meta name="twitter:description" content="{{ page_description | escape }}">{% endif %}
<meta name="twitter:image" content="https:{{ og_image | remove: 'https:' }}">
