{%- comment -%}
  Fallback product page for any product added later (not one of the 5 launch products).
  Uses a normal Shopify product form, so it works without extra JavaScript.
{%- endcomment -%}
{%- assign current_variant = product.selected_or_first_available_variant -%}
<div class="page pdp-hero">
  <div class="wrap">
    <nav class="crumbs" style="margin-top:30px" aria-label="Breadcrumb"><a href="{{ routes.root_url }}">Home</a> / <a href="{{ routes.all_products_collection_url }}">Shop</a> / <span aria-current="page">{{ product.title }}</span></nav>
    <div class="pdp">
      <div class="gallery">
        <div class="main-img">
          {%- if product.featured_image -%}
            {%- assign img_alt = product.featured_image.alt | default: product.title -%}
            {{ product.featured_image | image_url: width: 1000 | image_tag: loading: 'eager', class: 'photo', alt: img_alt }}
          {%- endif -%}
        </div>
        <p class="img-note">Image for illustration purposes only. Natural color and appearance may vary.</p>
      </div>
      <div class="pinfo">
        <h1 class="h-display">{{ product.title }}</h1>
        {%- if product.type != blank %}<span class="hs-tag">{{ product.type }}</span>{% endif %}
        <div class="pp">
          <span class="price">{{ current_variant.price | money }}</span>
          {%- if current_variant.compare_at_price > current_variant.price %}<s class="size">{{ current_variant.compare_at_price | money }}</s>{% endif -%}
        </div>
        {%- form 'product', product, class: 'veda-product-form' -%}
          {%- unless product.has_only_default_variant -%}
            <div class="field full" style="margin:18px 0">
              <select name="id" id="variant-{{ product.id }}">
                {%- for v in product.variants -%}
                  <option value="{{ v.id }}"{% if v == current_variant %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title }} — {{ v.price | money }}</option>
                {%- endfor -%}
              </select>
              <label for="variant-{{ product.id }}">Option</label>
            </div>
          {%- else -%}
            <input type="hidden" name="id" value="{{ current_variant.id }}">
          {%- endunless -%}
          <div class="buyrow">
            <input type="number" name="quantity" value="1" min="1" aria-label="Quantity" class="qty" style="width:90px;text-align:center">
            <button class="btn" type="submit"{% unless current_variant.available %} disabled{% endunless %}>
              {%- if current_variant.available %}Add to cart{% else %}Sold out{% endif -%}
            </button>
          </div>
        {%- endform -%}
        <div class="acc"><details open><summary>Description</summary><div class="in">{{ product.description }}</div></details></div>
        <p class="img-note" style="margin-top:24px">*These statements have not been evaluated by the Food and Drug Administration. This product is not intended to diagnose, treat, cure, or prevent any disease.</p>
      </div>
    </div>
  </div>
</div>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Product",
  "name": {{ product.title | json }},
  "description": {{ product.description | strip_html | json }},
  "url": {{ shop.url | append: product.url | json }},
  {%- if product.featured_image %}"image": {{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }},{% endif %}
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "offers": {
    "@type": "Offer",
    "price": {{ current_variant.price | money_without_currency | remove: ',' | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "availability": "https://schema.org/{% if current_variant.available %}InStock{% else %}OutOfStock{% endif %}",
    "url": {{ shop.url | append: product.url | json }}
  }
}
</script>
